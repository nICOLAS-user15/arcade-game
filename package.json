{
  "name": "pacman-arcade",
  "version": "2.0.0",
  "description": "A Pac-Man tribute built with HTML5 Canvas and vanilla JavaScript: 5 stages, 3 difficulties, endless mode, English and Portuguese.",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "start": "node server.js",
    "start:lan": "node server.js --lan",
    "test": "node --test",
    "build": "node scripts/build.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "javascript",
    "canvas",
    "game",
    "pacman",
    "pwa"
  ],
  "license": "MIT",
  "private": true
}
